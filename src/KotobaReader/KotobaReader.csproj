<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
    <Description>A local-first Windows comic reader with offline OCR and neural translation.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../KotobaReader.Core/KotobaReader.Core.csproj" />
    <Content Include="../../worker/*.py" Link="worker/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
